# Configuration file for local development.
#
# Prerequisites:
# - Postgres instance must have the pgvector extension available
# - The initial Alembic migration issues CREATE EXTENSION IF NOT EXISTS vector
# - Ollama must have the embedding model pulled: ollama pull qwen3-embedding:0.6b

DB_URL=postgresql://postgres:postgres@localhost:5433/ai_router_db
DB_ECHO_SQL=false
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
